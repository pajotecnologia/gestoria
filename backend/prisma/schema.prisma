datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  AGENCY_ADMIN
  CLIENT_ADMIN
  OPERATOR
}

enum PlanType {
  TRIAL
  STARTER
  PRO
  ENTERPRISE
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  document    String?  // CNPJ / CPF
  plan        PlanType @default(STARTER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  agents      Agent[]
  knowledge   KnowledgeFile[]
  rooms       Room[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model Agent {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  niche             String
  provider          String   @default("openai") // openai, groq, ollama
  model             String   @default("gpt-4o")
  temperature       Float    @default(0.4)
  
  // Estrutura RTCE
  roleText          String   @db.Text
  taskText          String   @db.Text
  contextText       String   @db.Text
  executionText     String   @db.Text
  
  // JSON de variáveis e System Prompt compilado
  variablesJson     Json     @default("{}")
  fullSystemPrompt  String   @db.Text
  
  // WhatsApp / Evolution API
  instanceName      String?  @unique
  whatsappStatus    String   @default("DISCONNECTED") // CONNECTED, DISCONNECTED, CONNECTING
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeFiles    KnowledgeFile[]

  @@index([tenantId])
  @@map("agents")
}

model KnowledgeFile {
  id            String   @id @default(uuid())
  tenantId      String
  agentId       String
  fileName      String
  fileSize      Int
  mimeType      String
  chunksCount   Int
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentId])
  @@map("knowledge_files")
}

// ==========================================
// SALAS DE REUNIÃO MULTI-AGENTE (WAR ROOM)
// ==========================================
model Room {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  topic       String   @db.Text
  targetAudience String? @db.Text
  objective   String?  @db.Text
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages    RoomMessage[]

  @@index([tenantId])
  @@map("rooms")
}

model RoomMessage {
  id          String   @id @default(uuid())
  roomId      String
  senderType  String   // USER, AGENT
  agentRole   String   // STRATEGIST, COPYWRITER, DESIGNER, VIDEOMAKER, TRAFFIC_MANAGER, HUMAN
  senderName  String
  content     String   @db.Text
  imageUrl    String?  @db.Text
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_messages")
}


model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
  @@index([userId])
  @@map("audit_logs")
}
