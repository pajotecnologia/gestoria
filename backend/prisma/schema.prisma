datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  AGENCY_ADMIN
  CLIENT_ADMIN
  OPERATOR
}

enum PlanType {
  TRIAL
  STARTER
  PRO
  ENTERPRISE
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  document    String?  // CNPJ / CPF
  plan        PlanType @default(STARTER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  agents      Agent[]
  specialists Specialist[]
  knowledge   KnowledgeFile[]
  rooms       Room[]
  auditLogs   AuditLog[]
  aiProviders AiProviderAccount[]
  aiUsage     AiUsage[]
  aiRequests  AiRequest[]
  clients     Client[]
  campaigns   Campaign[]
  resources   ClientResource[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model Agent {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  niche             String
  provider          String   @default("openai") // openai, groq, ollama
  model             String   @default("gpt-4o")
  temperature       Float    @default(0.4)
  
  // Estrutura RTCE
  roleText          String   @db.Text
  taskText          String   @db.Text
  contextText       String   @db.Text
  executionText     String   @db.Text
  
  // JSON de variáveis e System Prompt compilado
  variablesJson     Json     @default("{}")
  fullSystemPrompt  String   @db.Text
  
  // WhatsApp / Evolution API
  instanceName      String?  @unique
  whatsappStatus    String   @default("DISCONNECTED") // CONNECTED, DISCONNECTED, CONNECTING
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeFiles    KnowledgeFile[]
  campaigns         Campaign[]

  @@index([tenantId])
  @@map("agents")
}

model KnowledgeFile {
  id            String   @id @default(uuid())
  tenantId      String
  agentId       String?
  clientId      String?
  fileName      String
  fileSize      Int
  mimeType      String
  chunksCount   Int
  status        String   @default("READY") // PROCESSING, READY, ERROR
  errorMessage  String?  @db.Text
  extractedText String?  @db.Text
  contentHash   String?
  embeddingModel String  @default("text-embedding-3-small")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent         Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentId])
  @@index([tenantId, clientId])
  @@map("knowledge_files")
}

// ==========================================
// SALAS DE REUNIÃO MULTI-AGENTE (WAR ROOM)
// ==========================================
model Room {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  topic       String   @db.Text
  targetAudience String? @db.Text
  objective   String?  @db.Text
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages    RoomMessage[]

  @@index([tenantId])
  @@map("rooms")
}

model RoomMessage {
  id          String   @id @default(uuid())
  roomId      String
  senderType  String   // USER, AGENT
  agentRole   String   // STRATEGIST, COPYWRITER, DESIGNER, VIDEOMAKER, TRAFFIC_MANAGER, HUMAN
  senderName  String
  content     String   @db.Text
  imageUrl    String?  @db.Text
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_messages")
}

// ==========================================
// ESPECIALISTAS DO SQUAD / WAR ROOM
// ==========================================
model Specialist {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  roleKey       String   // Identificador único no tenant (ex: STRATEGIST, DEV, TRIBUTARIO, etc.)
  title         String   // Cargo / Especialidade
  avatarColor   String   @default("from-indigo-600 to-violet-600")
  iconName      String   @default("BrainCircuit")
  provider      String   @default("openai") // openai, gemini, groq, ollama
  model         String   @default("gpt-4o")
  temperature   Float    @default(0.7)
  systemPrompt  String   @db.Text
  generateImage Boolean  @default(false)
  isCustom      Boolean  @default(true)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleKey])
  @@index([tenantId, enabled])
  @@map("specialists")
}


model Client {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  legalName       String?
  document        String?
  segment         String?
  website         String?
  instagram       String?
  linkedin        String?
  description     String?  @db.Text
  targetAudience  String?  @db.Text
  productsOffers  String?  @db.Text
  brandVoice      String?  @db.Text
  goals           String?  @db.Text
  competitors     String?  @db.Text
  restrictions    String?  @db.Text
  notes           String?  @db.Text
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeFiles  KnowledgeFile[]
  campaigns       Campaign[]
  resources       ClientResource[]

  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("clients")
}

model ClientResource {
  id          String   @id @default(uuid())
  tenantId    String
  clientId    String
  title       String
  url         String   @db.Text
  type        String   @default("WEBSITE")
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
  @@map("client_resources")
}

model Campaign {
  id           String   @id @default(uuid())
  tenantId     String
  clientId     String
  agentId      String?
  name         String
  objective    String   @db.Text
  offer        String?  @db.Text
  audience     String?  @db.Text
  channels     String?  @db.Text
  budget       String?
  period       String?
  brief        String?  @db.Text
  strategy     String?  @db.Text
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent        Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId, status])
  @@index([tenantId, createdAt])
  @@map("campaigns")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
  @@index([userId])
  @@map("audit_logs")
}


model AiUsage {
  id               String   @id @default(uuid())
  requestId        String?
  tenantId         String
  providerAccountId String?
  provider         String
  model            String
  taskType         String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCost    Float?
  success          Boolean  @default(true)
  errorType        String?
  createdAt        DateTime @default(now())

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request          AiRequest?          @relation(fields: [requestId], references: [id], onDelete: SetNull)
  providerAccount  AiProviderAccount?  @relation(fields: [providerAccountId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, provider, createdAt])
  @@index([providerAccountId, createdAt])
  @@index([requestId])
  @@map("ai_usage")
}

model AiProviderAccount {
  id            String     @id @default(uuid())
  tenantId      String
  name          String
  provider      String
  model         String
  encryptedKey  String
  enabled       Boolean    @default(true)
  priority      Int        @default(100)
  lastError     String?
  lastUsedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usage         AiUsage[]

  @@index([tenantId, enabled, priority])
  @@map("ai_provider_accounts")
}

model AiRequest {
  id            String   @id @default(uuid())
  tenantId      String
  taskType      String
  success       Boolean  @default(false)
  provider      String?
  model         String?
  totalTokens   Int      @default(0)
  estimatedCost Float?
  createdAt     DateTime @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usage         AiUsage[]
  @@index([tenantId, createdAt])
  @@map("ai_requests")
}
