# ==========================================
# CONFIGURAÇÕES DO SERVIDOR & SEGURANÇA
# ==========================================
PORT=3000
NODE_ENV=production
JWT_SECRET=
APP_BACKEND_URL=http://backend:3000

# ==========================================
# BANCO DE DADOS (PostgreSQL + Prisma)
# ==========================================
# Para Coolify (rede interna): postgresql://postgres:SENHA@postgres:5432/saas_agents?schema=public
# Para Local: postgresql://postgres:postgrespassword@localhost:5432/saas_agents?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/saas_agents?schema=public"

# ==========================================
# REDIS (Filas BullMQ)
# ==========================================
# No Coolify use 'redis', localmente use 'localhost'
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# QDRANT (Vector DB para RAG)
# ==========================================
# No Coolify use 'http://qdrant:6333', localmente use 'http://localhost:6333'
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agency_saas_knowledge_base

# ==========================================
# PROVEDORES DE IA
# ==========================================
OPENAI_API_KEY=sk-proj-sua-chave-openai-aqui
GROQ_API_KEY=gsk_sua-chave-groq-aqui

# ==========================================
# EVOLUTION API (WhatsApp Gateway)
# ==========================================
# No Coolify use 'http://evolution_api:8080', localmente use 'http://localhost:8080'
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=

# ==========================================
# N8N WEBHOOK
# ==========================================
# No Coolify use 'http://n8n:5678/webhook/ai-agent'
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ai-agent

# Segurança de origem e webhook
CORS_ALLOWED_ORIGINS=http://localhost:5173
EVOLUTION_WEBHOOK_SECRET=
